rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Controlled storage access: only authenticated requests with matching tenant access
    match /tenants/{tenantId}/pod/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
